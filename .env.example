# Copy to .env and fill in (never commit .env)
# Bluesky Jetstream ingest (cfs/tweet.js): max posts/s; hashtag gate; BCP-47 langs (en matches en-US, en-GB)
BLUESKY_MAX_POSTS_PER_SEC=10
BLUESKY_REQUIRE_TOPIC=true
BLUESKY_LANGS=en
FINNHUB_API_KEY=your_finnhub_api_key_here
GEOPS_API_KEY=your_geops_api_key_here
MBTA_API_KEY=your_mbta_v3_api_key_here
