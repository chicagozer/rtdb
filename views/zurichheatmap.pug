extends nav
block vars
  - var title = 'Zurich Train Heatmap'
  - var viewId = 'a4b5c6d7-e8f9-4012-8b3c-4d5e6f7a8b9c'

block append head
  style.
    .zurich-map-wrap {
      position: relative;
      width: 100%;
      height: calc(100vh - 50px);
      min-height: 400px;
      background: #111;
    }
    #zurichheatmap_map {
      width: 100%;
      height: 100%;
    }
    .zurich-status {
      position: absolute;
      top: 10px;
      left: 10px;
      z-index: 2;
      max-width: 480px;
      padding: 8px 12px;
      font: 13px/1.4 Verdana, sans-serif;
      color: #eee;
      background: rgba(0, 0, 0, 0.72);
      border-radius: 4px;
      pointer-events: none;
    }
  link(rel='stylesheet', href='https://unpkg.com/maplibre-gl@4/dist/maplibre-gl.css')
  script(type='text/javascript', src='https://unpkg.com/maplibre-gl@4/dist/maplibre-gl.js')
  script(type='text/javascript').
    var viewId = '!{viewId}';
    var ZURICH_CENTER = [8.541, 47.376];
    var map;
    var source;
    var statusEl;

    function reductionToGeoJSON(reduction) {
      var features = [], i, row, stats;
      if (!reduction || !reduction.length) {
        return { type: 'FeatureCollection', features: [] };
      }
      for (i = 0; i < reduction.length; i = i + 1) {
        row = reduction[i];
        if (!row || row.length < 2) {
          continue;
        }
        stats = row[1];
        if (!stats || !stats.count) {
          continue;
        }
        features.push({
          type: 'Feature',
          geometry: {
            type: 'Point',
            coordinates: [stats.lng, stats.lat]
          },
          properties: {
            delay: stats.avgDelay || 0,
            maxDelay: stats.maxDelay || 0,
            count: stats.count
          }
        });
      }
      return { type: 'FeatureCollection', features: features };
    }

    function setStatus(text) {
      if (statusEl) {
        statusEl.textContent = text;
      }
    }

    function drawHeatmap(reduction) {
      var data = reductionToGeoJSON(reduction), n = data.features.length, src;
      if (!map || !map.getSource('trains')) {
        return;
      }
      src = map.getSource('trains');
      src.setData(data);
      setStatus(
        'Zurich SBB rail · rtdb map/reduce · ' + n + ' grid cells · weight = avg delay (s)'
      );
    }

    function registerStream() {
      var url = '/db/stream?view=' + viewId;
      source = new EventSource(url);
      source.addEventListener(viewId, function (event) {
        drawHeatmap(JSON.parse(event.data));
      }, false);
      source.onerror = function () {
        console.warn('EventSource error (zurich heatmap)');
      };
    }

    function initMap() {
      map = new maplibregl.Map({
        container: 'zurichheatmap_map',
        center: ZURICH_CENTER,
        zoom: 11.5,
        style: {
          version: 8,
          sources: {
            osm: {
              type: 'raster',
              tiles: ['https://tile.openstreetmap.org/{z}/{x}/{y}.png'],
              tileSize: 256,
              attribution: '© OpenStreetMap contributors'
            }
          },
          layers: [{
            id: 'osm',
            type: 'raster',
            source: 'osm'
          }]
        }
      });
      map.addControl(new maplibregl.NavigationControl(), 'top-right');
      map.on('load', function () {
        map.addSource('trains', {
          type: 'geojson',
          data: { type: 'FeatureCollection', features: [] }
        });
        map.addLayer({
          id: 'trains-heat',
          type: 'heatmap',
          source: 'trains',
          maxzoom: 15,
          paint: {
            'heatmap-weight': [
              'interpolate', ['linear'], ['get', 'delay'],
              0, 0,
              60, 0.25,
              180, 0.55,
              600, 1
            ],
            'heatmap-intensity': [
              'interpolate', ['linear'], ['zoom'],
              10, 0.6,
              14, 1.4
            ],
            'heatmap-color': [
              'interpolate', ['linear'], ['heatmap-density'],
              0, 'rgba(33, 102, 172, 0)',
              0.15, 'rgb(56, 189, 120)',
              0.35, 'rgb(250, 204, 21)',
              0.55, 'rgb(251, 146, 60)',
              0.75, 'rgb(239, 68, 68)',
              1, 'rgb(127, 29, 29)'
            ],
            'heatmap-radius': [
              'interpolate', ['linear'], ['zoom'],
              10, 14,
              13, 24,
              15, 34
            ],
            'heatmap-opacity': 0.9
          }
        });
        registerStream();
      });
    }

    jQuery(document).ready(function () {
      statusEl = document.getElementById('zurichheatmap_status');
      setStatus('Loading map…');
      initMap();
    });

block append content
  .zurich-map-wrap
    #zurichheatmap_status.zurich-status Loading…
    #zurichheatmap_map
