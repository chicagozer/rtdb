extends nav
block vars
  - var title = 'Bluesky Topics'
  - var collectionId = 'e38201e5-e928-44a9-a17e-3ad3fd0a3ba7'
  - var viewId = 'f31fc915-a37a-486b-b168-8fddfc3e054d'

block append head
    link(rel='stylesheet', href='/stylesheets/layout.css', type='text/css', media='screen')
    script(type='text/javascript', src='/symmetry/patch.js')
    script(type='text/javascript', src='https://www.google.com/jsapi')
    script(type='text/javascript').
      google.load('visualization', '1', { packages: ['corechart'] });
      google.setOnLoadCallback(registerStream);

      var collectionId = '!{collectionId}';
      var viewId = '!{viewId}';
      var chart;
      var myjson = null;
      var ticket;

      window.addEventListener('online', function () {
        reconnect();
      });

      function registerStream() {
        chart = new google.visualization.BubbleChart(document.getElementById('topic_bubble_div'));
        reconnect();
      }

      function reconnect() {
        $.getJSON('/db/collections/' + collectionId + '/views/' + viewId + '/ticket', function (data) {
          ticket = { view: viewId, ticket: data.ticket };
          reconnect2();
        });
      }

      function reconnect2() {
        var url = '/db/stream?delta=true&view=' + ticket.view + '&ticket=' + ticket.ticket;
        var source = new EventSource(url);

        source.addEventListener(viewId, function (event) {
          if (!myjson) {
            myjson = JSON.parse(event.data);
          } else {
            Symmetry.patch(myjson, JSON.parse(event.data));
          }
          drawBubble(myjson);
        }, false);
      }

      function drawBubble(reduction) {
        var data = new google.visualization.DataTable();
        var rows = [], i, row, stats, maxX = 0, maxY = 0;
        var hAxis = { title: 'Posts per minute (recent window)', viewWindow: { min: 0 } };
        var vAxis = { title: 'Unique authors', viewWindow: { min: 0 } };

        data.addColumn('string', 'Topic');
        data.addColumn('number', 'Posts per minute');
        data.addColumn('number', 'Unique authors');
        data.addColumn('number', 'Mentions');

        if (reduction && reduction.length) {
          for (i = 0; i < reduction.length; i++) {
            row = reduction[i];
            if (!row || row.length < 2) {
              continue;
            }
            stats = row[1];
            if (!stats || !stats.size) {
              continue;
            }
            if (stats.x > maxX) {
              maxX = stats.x;
            }
            if (stats.y > maxY) {
              maxY = stats.y;
            }
            rows.push([
              stats.label || row[0],
              stats.x || 0,
              stats.y || 0,
              stats.size || 0
            ]);
          }
        }

        if (rows.length) {
          hAxis.viewWindow.max = maxX + 1;
          vAxis.viewWindow.max = maxY + 1;
        }

        data.addRows(rows);
        chart.draw(data, {
          title: 'Live topic landscape (Bluesky Jetstream)',
          fontName: 'Verdana',
          backgroundColor: '#F9F8F6',
          hAxis: hAxis,
          vAxis: vAxis,
          bubble: { textStyle: { fontSize: 11 } },
          legend: 'none',
          width: '100%',
          height: 560
        });
      }

block append content
    section#main.column
      article.module.width_full
        header
          h3(style='line-height:inherit;') Bluesky topic landscape
        .module_content
          article.stats_graph
            #topic_bubble_div(style='width:100%;min-height:560px;')
          .clear
