extends nav
block vars
  - var title = 'Boston Crowding Heatmap'
  - var viewId = 'c2d3e4f5-a6b7-8901-bcde-f12345678901'

block append head
  style.
    .boston-map-wrap {
      position: relative;
      width: 100%;
      height: calc(100vh - 50px);
      min-height: 400px;
      background: #111;
    }
    #bostoncrowding_map {
      width: 100%;
      height: 100%;
    }
    .boston-status {
      position: absolute;
      top: 10px;
      left: 10px;
      z-index: 2;
      max-width: 520px;
      padding: 8px 12px;
      font: 13px/1.4 Verdana, sans-serif;
      color: #eee;
      background: rgba(0, 0, 0, 0.72);
      border-radius: 4px;
      pointer-events: none;
    }
  link(rel='stylesheet', href='https://unpkg.com/maplibre-gl@4/dist/maplibre-gl.css')
  script(type='text/javascript', src='https://unpkg.com/maplibre-gl@4/dist/maplibre-gl.js')
  script(type='text/javascript').
    var viewId = '!{viewId}';
    var BOSTON_CENTER = [-71.0589, 42.3601];
    var map;
    var source;
    var statusEl;

    function reductionToGeoJSON(reduction) {
      var features = [], i, row, stats;
      if (!reduction || !reduction.length) {
        return { type: 'FeatureCollection', features: [] };
      }
      for (i = 0; i < reduction.length; i = i + 1) {
        row = reduction[i];
        if (!row || row.length < 2) {
          continue;
        }
        stats = row[1];
        if (!stats || !stats.vehicles) {
          continue;
        }
        features.push({
          type: 'Feature',
          geometry: {
            type: 'Point',
            coordinates: [stats.lng, stats.lat]
          },
          properties: {
            crowding: stats.avgCrowding || 0,
            vehicles: stats.vehicles,
            maxCrowding: stats.maxCrowding || 0
          }
        });
      }
      return { type: 'FeatureCollection', features: features };
    }

    function setStatus(text) {
      if (statusEl) {
        statusEl.textContent = text;
      }
    }

    function drawHeatmap(reduction) {
      var data = reductionToGeoJSON(reduction), n = data.features.length, src;
      if (!map || !map.getSource('crowding')) {
        return;
      }
      src = map.getSource('crowding');
      src.setData(data);
      setStatus(
        'MBTA crowding · rtdb map/reduce · ' + n + ' areas · weight = avg crowding (not exact rider counts)'
      );
    }

    function registerStream() {
      var url = '/db/stream?view=' + viewId;
      source = new EventSource(url);
      source.addEventListener(viewId, function (event) {
        drawHeatmap(JSON.parse(event.data));
      }, false);
      source.onerror = function () {
        console.warn('EventSource error (boston crowding)');
      };
    }

    function initMap() {
      map = new maplibregl.Map({
        container: 'bostoncrowding_map',
        center: BOSTON_CENTER,
        zoom: 11.5,
        style: {
          version: 8,
          sources: {
            osm: {
              type: 'raster',
              tiles: ['https://tile.openstreetmap.org/{z}/{x}/{y}.png'],
              tileSize: 256,
              attribution: '© OpenStreetMap contributors'
            }
          },
          layers: [{
            id: 'osm',
            type: 'raster',
            source: 'osm'
          }]
        }
      });
      map.addControl(new maplibregl.NavigationControl(), 'top-right');
      map.on('load', function () {
        map.addSource('crowding', {
          type: 'geojson',
          data: { type: 'FeatureCollection', features: [] }
        });
        map.addLayer({
          id: 'crowding-heat',
          type: 'heatmap',
          source: 'crowding',
          maxzoom: 15,
          paint: {
            'heatmap-weight': [
              'interpolate', ['linear'], ['get', 'crowding'],
              0, 0,
              0.25, 0.2,
              0.55, 0.55,
              1, 1
            ],
            'heatmap-intensity': [
              'interpolate', ['linear'], ['zoom'],
              10, 0.8,
              14, 1.6
            ],
            'heatmap-color': [
              'interpolate', ['linear'], ['heatmap-density'],
              0, 'rgba(33, 102, 172, 0)',
              0.2, 'rgb(56, 189, 120)',
              0.45, 'rgb(250, 204, 21)',
              0.65, 'rgb(251, 146, 60)',
              0.85, 'rgb(239, 68, 68)',
              1, 'rgb(127, 29, 29)'
            ],
            'heatmap-radius': [
              'interpolate', ['linear'], ['zoom'],
              10, 16,
              13, 26,
              15, 36
            ],
            'heatmap-opacity': 0.9
          }
        });
        registerStream();
      });
    }

    jQuery(document).ready(function () {
      statusEl = document.getElementById('bostoncrowding_status');
      setStatus('Loading map…');
      initMap();
    });

block append content
  .boston-map-wrap
    #bostoncrowding_status.boston-status Loading…
    #bostoncrowding_map
